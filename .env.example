APP_NAME=APIL
APP_ENV=production
APP_VERSION=1.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

REDIS_URL=redis://USER:PASSWORD@HOST:6379/0

APIL_API_KEY=

OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PREDICT=4096

OLLAMA_ENABLED=true
OLLAMA_MAX_RETRIES=1
OLLAMA_PRIORITY=1
OLLAMA_FALLBACK_ENABLED=true

OPENAI_ENABLED=true
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2
OPENAI_PRIORITY=2
OPENAI_FALLBACK_ENABLED=true

GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=2
GROQ_PRIORITY=5
GROQ_FALLBACK_ENABLED=true

GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=2
GEMINI_PRIORITY=3
GEMINI_FALLBACK_ENABLED=true

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_PRIORITY=4
ANTHROPIC_FALLBACK_ENABLED=true


# =========================
# APIL CIRCUIT BREAKER
# =========================

APIL_CIRCUIT_FAILURE_THRESHOLD=3
APIL_CIRCUIT_RECOVERY_TIMEOUT=30
APIL_MAX_IMPROVEMENT_ATTEMPTS=1
APIL_IMPROVEMENT_TIMEOUT_SECONDS=10
APIL_ENABLE_DEBUG_METADATA=true

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60